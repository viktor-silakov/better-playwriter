{
  "name": "root",
  "private": true,
  "scripts": {
    "test": "pnpm --filter better-playwriter test",
    "watch": "pnpm -r watch",
    "format": "prettier --write .",
    "cli": "pnpm --filter better-playwriter cli",
    "build": "pnpm --filter better-playwriter --filter mcp-extension build",
    "reload": "pnpm --filter better-playwriter build && tsx playwriter/src/cli.ts serve restart && pnpm --filter mcp-extension reload",
    "release:check-cli-version": "tsx scripts/check-extension-cli-version.ts",
    "release": "node scripts/package-extension.mjs",
    "bootstrap": "git submodule update --init && pnpm patchright:build && pnpm install && node playwright/packages/playwright-core/build.mjs",
    "patchright:build": "cd patchright-playwriter && bash utils/rebuild_local_package.sh",
    "playwright:build": "node playwright/packages/playwright-core/build.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "fflate": "^0.8.3"
  },
  "license": "MIT",
  "dependencies": {
    "mcp-extension": "workspace:^"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ],
    "overrides": {
      "spiceflow": "1.26.0-rsc.22"
    }
  }
}
