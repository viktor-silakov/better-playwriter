{
  "$schema": "https://holocron.so/docs.json",
  "name": "Better Playwriter",
  "description": "Documentation for Better Playwriter, the local Chrome automation CLI and MCP server.",
  "logo": {
    "light": "/playwriter-logo.svg",
    "dark": "/playwriter-logo.svg",
    "href": "/"
  },
  "favicon": {
    "light": "/favicon-32.png",
    "dark": "/favicon-32.png"
  },
  "colors": {
    "primary": "#315BDA",
    "light": "#315BDA",
    "dark": "#A7BEFF"
  },
  "knownPaths": [
    "/api/*",
    "/login",
    "/dashboard",
    "/device",
    "/privacy",
    "/.well-known/*",
    "/resources/*",
    "/SKILL"
  ],
  "redirects": [
    {
      "source": "/changelog",
      "destination": "/changelog/intro",
      "permanent": true
    }
  ],
  "decorativeLines": "none",
  "layout": {
    "mode": "compact"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "lucide:book",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "lucide:rocket",
            "pages": [
              "index",
              "docs/installation",
              "docs/quick-start",
              "docs/cli",
              "docs/mcp-setup"
            ]
          },
          {
            "group": "Features",
            "icon": "lucide:sparkles",
            "pages": [
              "docs/snapshots",
              "docs/visual-labels",
              "docs/sessions",
              "docs/debugger",
              "docs/network",
              "docs/recording",
              "docs/streaming",
              "docs/headless",
              "docs/profiling",
              "docs/security",
              "docs/remote-control"
            ]
          },
          {
            "group": "Guides",
            "icon": "lucide:book-open",
            "pages": [
              "docs/remote-access",
              "docs/cloud-browsers",
              "docs/use-cases",
              "docs/troubleshooting"
            ]
          },
          {
            "group": "Comparison",
            "icon": "lucide:git-compare",
            "pages": [
              "docs/vs-chrome-cdp",
              "docs/vs-playwright-mcp",
              "docs/vs-playwright-cli",
              "docs/vs-browser-mcp",
              "docs/vs-agent-browser",
              "docs/vs-claude-extension"
            ]
          },
          {
            "group": "Reference",
            "icon": "lucide:book-text",
            "pages": [
              "docs/skill",
              "docs/configuration",
              "privacy"
            ]
          }
        ]
      },
      {
        "tab": "Skill Recorder",
        "icon": "lucide:circle-dot",
        "pages": [
          "docs/skill-recorder"
        ]
      },
      {
        "tab": "Changelog",
        "icon": "lucide:newspaper",
        "pages": [
          "changelog/intro"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "label": "Install",
      "href": "/docs/installation"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Better Playwriter",
        "items": [
          {
            "label": "Installation",
            "href": "/docs/installation"
          },
          {
            "label": "Changelog",
            "href": "/changelog/intro"
          },
          {
            "label": "Privacy",
            "href": "/privacy"
          }
        ]
      }
    ]
  }
}
