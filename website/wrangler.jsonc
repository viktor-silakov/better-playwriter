{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "better-playwriter-website",
  "main": "./src/server.tsx",
  "workers_dev": true,
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },

  // ── Production (top-level) ──────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "better-playwriter-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../db/drizzle",
      "migrations_pattern": "../db/drizzle/*/migration.sql"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REMOTE_CONTROL_TUNNEL", "class_name": "RemoteControlTunnel" }
    ]
  },
  "ratelimits": [
    {
      "name": "REMOTE_CONTROL_RATE_LIMITER",
      "namespace_id": "42305",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],
  "migrations": [
    { "tag": "remote-control-v1", "new_classes": ["RemoteControlTunnel"] }
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "BROWSER_USE_API_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]  // every minute: enforce proxy spend budgets
  },

  // ── Preview ─────────────────────────────────────────────────────────
  // Bindings are NOT inherited — must duplicate everything here
  "env": {
    "preview": {
      "name": "better-playwriter-website-preview",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "REMOTE_CONTROL_TUNNEL", "class_name": "RemoteControlTunnel" }
        ]
      },
      "ratelimits": [
        {
          "name": "REMOTE_CONTROL_RATE_LIMITER",
          "namespace_id": "42306",
          "simple": { "limit": 10000, "period": 60 }
        }
      ],
      "migrations": [
        { "tag": "remote-control-v1", "new_classes": ["RemoteControlTunnel"] }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "better-playwriter-preview-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../db/drizzle",
          "migrations_pattern": "../db/drizzle/*/migration.sql"
        }
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "BETTER_AUTH_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "BROWSER_USE_API_KEY",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET"
        ]
      },
      "triggers": {
        "crons": ["* * * * *"]
      }
    }
  }
}
